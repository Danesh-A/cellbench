# Copy to `.env` and adjust for your environment.

ENV=dev
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------
DATABASE_URL=postgresql+psycopg://cellbench:cellbench@db:5432/cellbench

# --- Auth ------------------------------------------------------------
JWT_SECRET=change-me-in-prod-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=604800

# --- Object storage --------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cellbench
S3_PUBLIC_URL=http://localhost:9000
PRESIGNED_URL_TTL=900

# --- CORS ------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
